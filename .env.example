# Choose ONE backend by setting LLM_BACKEND (default: groq)
# Then fill in the corresponding credentials below.

# ─── Option A: Direct Anthropic API ─────────────────────────────────────────
# LLM_BACKEND=anthropic
# ANTHROPIC_API_KEY=sk-ant-api03-...

# ─── Option B: Corporate/internal proxy ────────────────────────────────────
# LLM_BACKEND=anthropic
# ANTHROPIC_BASE_URL=https://your-proxy-base-url
# ANTHROPIC_AUTH_TOKEN=your-auth-token
# Newline-separated "Key: Value" pairs, e.g.:
# ANTHROPIC_CUSTOM_HEADERS=X-Custom-Header: value\nX-Another: value2
# ANTHROPIC_CUSTOM_HEADERS=

# ─── Option C: Groq (default backend) ──────────────────────────────────────
# LLM_BACKEND=groq
# GROQ_API_KEY=gsk-...

# ─── Other supported backends (uncomment to use) ───────────────────────────
# LLM_BACKEND=openai        # requires OPENAI_API_KEY
# LLM_BACKEND=cerebras      # requires CEREBRAS_API_KEY
# LLM_BACKEND=together      # requires TOGETHER_API_KEY
# LLM_BACKEND=sambanova     # requires SAMBANOVA_API_KEY
