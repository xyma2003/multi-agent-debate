# Multi-Agent Debate — API credentials
# Copy to .env and fill in ONE backend.

# ─── Option A: SiliconFlow / OpenAI-compatible (国内推荐) ──────────────────
# 获取 key: https://cloud.siliconflow.cn/ (有免费额度)
LLM_BACKEND=openai
OPENAI_API_KEY=sk-...
OPENAI_API_BASE=https://api.siliconflow.cn/v1
OPENAI_MODEL=Qwen/Qwen3-32B

# ─── Option B: Anthropic (海外) ────────────────────────────────────────────
# LLM_BACKEND=anthropic
# ANTHROPIC_API_KEY=sk-ant-api03-...

# ─── Option C: Corporate proxy ─────────────────────────────────────────────
# LLM_BACKEND=anthropic
# ANTHROPIC_BASE_URL=https://your-proxy-base-url
# ANTHROPIC_AUTH_TOKEN=your-auth-token
# ANTHROPIC_CUSTOM_HEADERS=X-Custom-Header: value

# ─── Option D: Groq (default backend if LLM_BACKEND unset) ─────────────────
# LLM_BACKEND=groq
# GROQ_API_KEY=gsk-...

# ─── Other supported backends ──────────────────────────────────────────────
# LLM_BACKEND=cerebras      # requires CEREBRAS_API_KEY
# LLM_BACKEND=together      # requires TOGETHER_API_KEY
# LLM_BACKEND=sambanova     # requires SAMBANOVA_API_KEY
